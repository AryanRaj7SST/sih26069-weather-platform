# Application Configuration
ENVIRONMENT=development
DEBUG=true
PROJECT_NAME="National Weather Big Data Analytics Platform"
API_V1_STR=/api/v1

# Security & Authentication
SECRET_KEY=change-this-to-a-secure-random-64-character-hex-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# PostgreSQL + PostGIS (Container & Backend)
POSTGRES_DB=weather_platform
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/weather_platform
DATABASE_ECHO=false

# Cache & Event Streaming (Redis)
REDIS_URL=redis://localhost:6379/0

# Object Storage (MinIO / S3)
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_BUCKET_NAME=weather-media
S3_REGION=us-east-1
S3_USE_SSL=false

# External Weather Portals (Optional in Local Dev)
DATA_GOV_API_KEY=
IMD_API_ENDPOINT=https://mausam.imd.gov.in/api/v1
IMD_API_KEY=

# AI & Semantic Intelligence (Optional in Local Dev)
EMBEDDING_MODEL_NAME=BAAI/bge-small-en-v1.5
LLM_PROVIDER=none
LLM_API_KEY=

# CORS Allowed Origins
ALLOWED_ORIGINS=["http://localhost:5173","http://localhost:3000"]
